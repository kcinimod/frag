  "notes": [
    {
      "number": 1,
      "title": "Accounting Policies",
      "next_heading": 2,
      "interpretation": "US GAAP and consolidated Microsoft plus subsidiaries, with intercompany eliminations. Revenue is recognized on transfer of control. Disclosed prior-period recasts had no effect on the consolidated income statements. Foreign currency revenue is translated at average rates.",
      "locator": {
        "start": {
          "line": 7233,
          "character": 1
        },
        "end_exclusive": {
          "line": 7608,
          "character": 1
        }
      },
      "sha256": "fc7eaa52f7ab11bc87c6fceaf94224ee88eeead8532bd8d228290ba76b889a46",
      "scope_caveat": "Reported revenue reflects foreign currency translation at average rates for each year."
    },
    {
      "number": 8,
      "title": "Business Combinations",
      "next_heading": 9,
      "interpretation": "Nuance entered consolidated results on March 4, 2022, partway through FY2022. ZeniMax entered in March 2021 before both periods. Activision Blizzard was pending as of the filing.",
      "locator": {
        "start": {
          "line": 13913,
          "character": 1
        },
        "end_exclusive": {
          "line": 14339,
          "character": 1
        }
      },
      "sha256": "b34e1d7aee77aa571a3e36eaa4070787e2bddfa2e3f0c7a75dae6f02835d72b3",
      "scope_caveat": "Nuance was consolidated from March 4, 2022. FY2022 includes a partial year of Nuance and FY2023 includes a full year."
    },
    {
      "number": 13,
      "title": "Unearned Revenue",
      "next_heading": 14,
      "interpretation": "Contract liability rollforward and remaining performance obligations provide timing context for recognition. Unearned revenue balances are distinct from recognized total revenue.",
      "locator": {
        "start": {
          "line": 17612,
          "character": 1
        },
        "end_exclusive": {
          "line": 17827,
          "character": 1
        }
      },
      "sha256": "b8c6684408f0b606d270ea21852dced19de3625e22a724fcb0ead80727d0f9f7"
    },
    {
      "number": 19,
      "title": "Segment Information and Geographic Data",
      "next_heading": null,
      "interpretation": "Prior segment amounts were recast for internal management reporting. The segment revenue table reconciles to consolidated total revenue for both years.",
      "locator": {
