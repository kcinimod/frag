    "company": "Microsoft Corporation",
    "comparison": {
      "basis": "The adjoining annual periods use the same June 30 year-end and reported consolidated US GAAP revenue definition in the FY2023 filing. The FY2022 observation is the comparative reported in that filing. Note 1 says the disclosed recasts did not affect consolidated income statements.",
      "evidence": [
        {
          "id": "segment_recast",
          "interpretation": "MD&A describes recast prior-period segment amounts on the internal management reporting basis.",
          "locator": {
            "end_exclusive": {
              "character": 1,
              "line": 1912
            },
            "start": {
              "character": 1,
              "line": 1909
            }
          },
          "sha256": "c2067d33778a19e836fc95725da769ca985c6310d0b1120ba6e11615ea00c5f5"
        },
        {
          "id": "acquisition_and_exchange_rates",
          "interpretation": "The FY2023 versus FY2022 discussion identifies a foreign currency impact on reported revenue and separately discusses Nuance and Xandr in operating expenses.",
          "locator": {
            "end_exclusive": {
              "character": 1,
              "line": 2324
            },
            "start": {
              "character": 1,
              "line": 2315
            }
          },
          "scope_caveat": "Microsoft disclosed an unfavorable foreign currency impact on revenue in its FY2023 comparison.",
          "sha256": "626d2c5b77a7b26ce07edf2a88c3f4f6eabd9df6a1d46925fe7b2a519f7b0467"
        },
        {
          "id": "xandr_acquisition",
          "interpretation": "The More Personal Computing discussion identifies Xandr as a contributor to search and news advertising revenue excluding traffic acquisition costs.",
          "locator": {
            "end_exclusive": {
              "character": 1,
              "line": 2672
            },
            "start": {
              "character": 1,
              "line": 2671
            }
          },
          "scope_caveat": "The filing identifies Xandr in a component revenue discussion. This evidence supplies no adjustment to total consolidated revenue.",
          "sha256": "9a4bcc08c1d6cb9c8547840de05246ebac3d207a3cde9c0ae37432b0b7e9040c"
        }
      ],
      "reference_status": "compatible",
      "scope_caveats": [
        "Reported revenue reflects foreign currency translation at average rates for each year.",
        "Nuance was consolidated from March 4, 2022. FY2022 includes a partial year of Nuance and FY2023 includes a full year.",
        "Microsoft disclosed an unfavorable foreign currency impact on revenue in its FY2023 comparison.",
        "The filing identifies Xandr in a component revenue discussion. This evidence supplies no adjustment to total consolidated revenue."
      ],
      "status": "compatible",
      "unresolved_requirements": []
    },
