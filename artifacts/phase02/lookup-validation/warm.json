      "applicable_notes": [
        {
          "interpretation": "US GAAP and consolidated Microsoft plus subsidiaries, with intercompany eliminations. Revenue is recognized on transfer of control. Disclosed prior-period recasts had no effect on the consolidated income statements. Foreign currency revenue is translated at average rates.",
          "locator": {
            "end_exclusive": {
              "character": 1,
              "line": 7608
            },
