            "start_byte": 3048761,
            "end_byte": 3283061,
            "sha256": "fc7eaa52f7ab11bc87c6fceaf94224ee88eeead8532bd8d228290ba76b889a46"
          },
          "comparison_only": false
        },
        {
          "label": "Business Combinations",
          "meaning": "Nuance entered consolidated results on March 4, 2022, partway through FY2022. ZeniMax entered in March 2021 before both periods. Activision Blizzard was pending as of the filing.",
